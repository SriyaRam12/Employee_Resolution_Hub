        <description>An employee can set requester to themselves only while the ticket is being inserted. After submission they can never change it.</description>
        <local_or_existing>Existing</local_or_existing>
        <name>x_412993_employe_1_ticket.requester</name>
        <operation display_value="write">write</operation>
        <script><![CDATA[
    // Employees may stamp themselves as requester while raising the ticket,
    // but can never change the requester afterwards.
    var esrUser = gs.getUserID();
    answer = false;
    if (current && current.isNewRecord()) {
        var esrRequester = current.getValue('requester');
        answer = !esrRequester || esrRequester == esrUser;
    }
]]></script>
