        <decision_type>allow</decision_type>
        <description>Support staff can read a ticket assigned to them, assigned to a group they belong to, or that they raised themselves.</description>
        <local_or_existing>Existing</local_or_existing>
        <name>x_412993_employe_1_ticket</name>
        <operation display_value="read">read</operation>
        <script><![CDATA[
    // Support staff visibility: own work, own group's work, own tickets.
    var esrUser = gs.getUserID();
    answer = false;
    if (current) {
        var esrGroup = current.getValue('assignment_group');
        answer = current.getValue('assigned_to') == esrUser || current.getValue('requester') == esrUser;
        if (!answer && esrGroup) {
            answer = gs.getUser().isMemberOf(esrGroup);
        }
    }
]]></script>
